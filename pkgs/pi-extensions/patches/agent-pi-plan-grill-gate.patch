+// ABOUTME: Enforces a session-local grill-with-docs checkpoint before PLAN review.
+// ABOUTME: The checkpoint is process state only; durable decisions remain in CONTEXT.md or ADRs.
+
+import type { ExtensionAPI } from "@mariozechner/pi-coding-agent";
+import { Type } from "@sinclair/typebox";
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join, resolve } from "node:path";
+
+interface GrillCheckpoint {
+	planFilePath: string;
+	planHash: string;
+	summary: string;
+	decisions: string[];
+	openQuestions: string[];
+	skillPath: string;
+}
+
+function skillPath(): string {
+	return join(homedir(), ".pi", "agent", "skills", "grill-with-docs", "SKILL.md");
+}
+
+function readSkill(path: string): boolean {
+	try {
+		return /^name:\s*grill-with-docs\b/m.test(readFileSync(path, "utf-8"));
+	} catch {
+		return false;
+	}
+}
+
+function resetPlanGrill(): void {
+	const g = globalThis as any;
+	g.__piPlanGrillComplete = false;
+	g.__piPlanGrillCheckpoint = null;
+}
+
+export default function (pi: ExtensionAPI): void {
+	const g = globalThis as any;
+	g.__piResetPlanGrill = resetPlanGrill;
+	resetPlanGrill();
+
+	pi.registerTool({
+		name: "grill_with_docs",
+		label: "Grill With Docs",
+		description:
+			"Bind the completed grill-with-docs checkpoint to the current PLAN file. " +
+			"Run the skill's question rounds first and write .context/todo.md; this tool verifies the current bytes.",
+		parameters: Type.Object({
+			plan_file_path: Type.String({ description: "Current plan path; must resolve to .context/todo.md." }),
+			summary: Type.String({ description: "Non-empty summary of the shared understanding." }),
+			decisions: Type.Optional(Type.Array(Type.String(), { description: "Confirmed terminology and decisions." })),
+			open_questions: Type.Array(Type.String(), { description: "Questions that remain unresolved; must be empty to complete." }),
+		}),
+
+		async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
+			if (g.__piCurrentMode !== "PLAN") {
+				return {
+					content: [{ type: "text", text: "Error: grill_with_docs is only a PLAN-mode checkpoint." }],
+					details: { complete: false, error: "plan_mode_required" },
+				};
+			}
+
+			const { plan_file_path: planFilePath, summary, decisions = [], open_questions: openQuestions } = params as {
+				plan_file_path: string;
+				summary: string;
+				decisions?: string[];
+				open_questions: string[];
+			};
+			const cwd = ctx?.cwd || process.cwd();
+			const absolutePlanPath = resolve(cwd, planFilePath.trim());
+			const expectedPlanPath = resolve(cwd, ".context/todo.md");
+			if (absolutePlanPath !== expectedPlanPath) {
+				return {
+					content: [{ type: "text", text: "Error: grill_with_docs must bind the current .context/todo.md plan." }],
+					details: { complete: false, error: "plan_grill_plan_path_required" },
+				};
+			}
+
+			const trimmedSummary = summary.trim();
+			const skill = skillPath();
+			if (!readSkill(skill)) {
+				return {
+					content: [{ type: "text", text: `Error: grill-with-docs skill not found or invalid at ${skill}. Restore the skill before planning.` }],
+					details: { complete: false, error: "skill_missing", skillPath: skill },
+				};
+			}
+			if (!trimmedSummary || openQuestions.length > 0) {
+				return {
+					content: [{ type: "text", text: "Error: grill checkpoint requires a non-empty summary and zero open questions." }],
+					details: { complete: false, error: "open_questions_remaining" },
+				};
+			}
+
+			let content: string;
+			try {
+				content = readFileSync(absolutePlanPath, "utf-8");
+			} catch {
+				return {
+					content: [{ type: "text", text: "Error: write .context/todo.md with a ## Grill checkpoint section before calling grill_with_docs." }],
+					details: { complete: false, error: "plan_missing" },
+				};
+			}
+			if (!/^##\s+Grill checkpoint\b/im.test(content)) {
+				return {
+					content: [{ type: "text", text: "Error: .context/todo.md must include the ## Grill checkpoint section." }],
+					details: { complete: false, error: "plan_grill_section_required" },
+				};
+			}
+
+			const planHash = createHash("sha256").update(content, "utf8").digest("hex");
+			const checkpoint: GrillCheckpoint = {
+				planFilePath: absolutePlanPath,
+				planHash,
+				summary: trimmedSummary,
+				decisions,
+				openQuestions,
+				skillPath: skill,
+			};
+			g.__piPlanGrillComplete = true;
+			g.__piPlanGrillCheckpoint = checkpoint;
+			return {
+				content: [{
+					type: "text",
+					text: `Grill checkpoint complete and bound to ${planFilePath}. Call plannotator_review for this same file; do not edit it before review.`,
+				}],
+				details: { complete: true, checkpoint },
+			};
+		},
+	});
+
+	pi.on("session_start", async () => resetPlanGrill());
+	pi.on("session_switch", async () => resetPlanGrill());
+}
