#!/bin/sh
# Adapted from duma799/yabai-config for macOS, with SIP enabled.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.nix-profile/bin:/etc/profiles/per-user/$(id -un)/bin:/run/current-system/sw/bin:/usr/bin:/bin:/usr/sbin:/sbin"
CONFIG_ROOT="@runtime@"

yabai -m config layout bsp
yabai -m config auto_balance on
yabai -m config split_ratio 0.5
yabai -m config split_type auto
yabai -m config window_placement first_child
yabai -m config external_bar all:37:0
yabai -m config top_padding 10
yabai -m config bottom_padding 10
yabai -m config left_padding 10
yabai -m config right_padding 10
yabai -m config window_gap 10

yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse autoraise
yabai -m config mouse_modifier fn
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

# Named rules/signals keep reloads idempotent.
for label in system-settings calculator activity-monitor archive-utility finder preferences scratchpad; do
    yabai -m rule --remove "yabaduma-$label" 2>/dev/null || true
done
yabai -m rule --add label=yabaduma-system-settings app='^(System Settings|システム設定)$' manage=off
yabai -m rule --add label=yabaduma-calculator app='^(Calculator|計算機)$' manage=off
yabai -m rule --add label=yabaduma-activity-monitor app='^(Activity Monitor|アクティビティモニタ)$' manage=off
yabai -m rule --add label=yabaduma-archive-utility app='^(Archive Utility|アーカイブユーティリティ)$' manage=off
yabai -m rule --add label=yabaduma-finder app='^Finder$' manage=off
yabai -m rule --add label=yabaduma-preferences title='Preferences$|Settings$' manage=off
yabai -m rule --add label=yabaduma-scratchpad app='^Ghostty$' title='^scratchpad$' manage=off grid=10:10:1:1:8:7

for event in display_added display_removed display_changed space_created space_destroyed; do
    yabai -m signal --remove "yabaduma-$event" 2>/dev/null || true
    yabai -m signal --add label="yabaduma-$event" event="$event" action="@python@ '$CONFIG_ROOT/adjust_padding.py'; '$CONFIG_ROOT/brew-tool' sketchybar --reload"
done
@python@ "$CONFIG_ROOT/adjust_padding.py"

# --add affects future windows. Reapply only our named rules to windows that
# were already open when yabai started, or when this config is reloaded.
for label in system-settings calculator activity-monitor archive-utility finder preferences scratchpad; do
    yabai -m rule --apply "yabaduma-$label"
done
