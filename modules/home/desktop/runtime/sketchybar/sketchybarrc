#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.nix-profile/bin:/etc/profiles/per-user/$(id -un)/bin:/run/current-system/sw/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export YABAI_CONFIG_PYTHON="${YABAI_CONFIG_PYTHON:-@python@}"
PYTHON="$YABAI_CONFIG_PYTHON"
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
export CONFIG_DIR
PLUGIN_DIR="$CONFIG_DIR/plugins"
eval "$("$PYTHON" "$CONFIG_DIR/colors.py")"

# SketchyBar adds the visible native menu bar's height itself when topmost=off.
# yabai's external_bar all:37:0 reserves this extra row below the menu bar.
sketchybar --bar position=top height=37 y_offset=0 topmost=off display=all \
  blur_radius=36 color="$BAR_COLOR" corner_radius=0 border_width=0 margin=0 \
  notch_width=200 notch_offset=0 padding_left=10 padding_right=10
sketchybar --default padding_left=5 padding_right=5 \
  icon.font="Hack Nerd Font:Bold:17.0" label.font="Hack Nerd Font:Bold:14.0" \
  icon.color="$ICON_COLOR" label.color="$LABEL_COLOR" \
  icon.padding_left=4 icon.padding_right=4 label.padding_left=4 label.padding_right=4

sketchybar --add item front_app left --set front_app icon.drawing=off \
  label.max_chars=28 label.font="Hack Nerd Font:Bold:13.0" \
  script="\"$PYTHON\" \"$PLUGIN_DIR/front_app.py\"" \
  --subscribe front_app front_app_switched
sketchybar --add item spaces_controller left --set spaces_controller drawing=off updates=on \
  update_freq=30 script="\"$PYTHON\" \"$PLUGIN_DIR/sync_spaces.py\"" \
  --subscribe spaces_controller space_change display_change space_windows_change system_woke

sketchybar --add item clock right --set clock icon.drawing=off label.color="$ACCENT_COLOR" \
  update_freq=10 script="\"$PYTHON\" \"$PLUGIN_DIR/clock.py\"" \
  --add item volume right --set volume icon="󰕾" label="–" label.color="$ACCENT_COLOR" \
  script="\"$PYTHON\" \"$PLUGIN_DIR/volume.py\"" --subscribe volume volume_change \
  --add item wifi right --set wifi update_freq=30 \
  script="\"$PYTHON\" \"$PLUGIN_DIR/wifi.py\"" --subscribe wifi system_woke \
  --add item bluetooth right --set bluetooth update_freq=30 \
  script="\"$PYTHON\" \"$PLUGIN_DIR/bluetooth.py\"" --subscribe bluetooth system_woke \
  --add item battery right --set battery update_freq=120 label.color="$ACCENT_COLOR" \
  script="\"$PYTHON\" \"$PLUGIN_DIR/battery.py\"" \
  --subscribe battery system_woke power_source_change

"$PYTHON" "$PLUGIN_DIR/sync_spaces.py"
sketchybar --update
