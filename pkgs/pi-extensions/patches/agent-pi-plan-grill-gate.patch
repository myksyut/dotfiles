+// ABOUTME: Enforces a session-local grill-with-docs checkpoint before PLAN review.
+// ABOUTME: The checkpoint is process state only; durable decisions remain in CONTEXT.md or ADRs.
+
+import type { ExtensionAPI } from "@mariozechner/pi-coding-agent";
+import { Type } from "@sinclair/typebox";
+import { createHash, randomUUID } from "node:crypto";
+import {
+	closeSync,
+	constants as fsConstants,
+	fstatSync,
+	lstatSync,
+	openSync,
+	readFileSync,
+	readSync,
+	realpathSync,
+} from "node:fs";
+import { homedir } from "node:os";
+import { dirname, isAbsolute, join, resolve } from "node:path";
+
+export interface GrillCheckpoint {
+	planFilePath: string;
+	planHash: string;
+	summary: string;
+	decisions: string[];
+	openQuestions: string[];
+	skillPath: string;
+}
+
+export interface PlanGrillFailure {
+	ok: false;
+	error: string;
+	message: string;
+}
+
+export interface PlanGrillReady {
+	ok: true;
+	absolute: string;
+	planHash: string;
+	bytes: Buffer;
+}
+
+export interface PlanReviewBegin {
+	ok: true;
+	token: string | null;
+	generation: number;
+}
+
+export interface PlanReviewLease {
+	accepted: boolean;
+	stale: boolean;
+}
+
+interface InFlightReview {
+	token: string;
+	generation: number;
+}
+
+const BLOCKED_PLAN_EXTERNAL_TOOLS = new Set(["plannotator_submit_plan", "plannotator_review"]);
+const GATED_INTERNAL_PLAN_TOOLS = new Set(["show_plan"]);
+const HEADING = /^##\s+Grill checkpoint\b/;
+const OPEN_NONE = /^(なし。?|none|)$/i;
+
+function decodeUtf8Strict(latin1: string): string | undefined {
+	try {
+		return new TextDecoder("utf-8", { fatal: true }).decode(Buffer.from(latin1, "latin1"));
+	} catch {
+		return undefined;
+	}
+}
+
+function isOpenNone(latin1: string): boolean {
+	const text = decodeUtf8Strict(trimLatin1(latin1));
+	return text !== undefined && OPEN_NONE.test(text.trim());
+}
+
+export const planGrillIo = {
+	openSync,
+	fstatSync,
+	readSync,
+	closeSync,
+	lstatSync,
+	realpathSync,
+};
+
+function g(): any {
+	return globalThis as any;
+}
+
+function stateInit(): void {
+	const state = g();
+	if (typeof state.__piPlanGrillGeneration !== "number") state.__piPlanGrillGeneration = 0;
+	if (state.__piPlanReviewInFlight === undefined) state.__piPlanReviewInFlight = null;
+}
+
+export function skillPath(): string {
+	return join(homedir(), ".pi", "agent", "skills", "grill-with-docs", "SKILL.md");
+}
+
+export function readSkill(path: string): boolean {
+	try {
+		return /^name:\s*grill-with-docs\b/m.test(readFileSync(path, "utf-8"));
+	} catch {
+		return false;
+	}
+}
+
+export function hashPlanBytes(bytes: Buffer | string): string {
+	const buf = typeof bytes === "string" ? Buffer.from(bytes, "utf8") : bytes;
+	return createHash("sha256").update(buf).digest("hex");
+}
+
+export function realCwd(cwd: string): string | undefined {
+	try {
+		const real = planGrillIo.realpathSync(cwd);
+		const st = planGrillIo.lstatSync(real);
+		if (!st.isDirectory()) return undefined;
+		return real;
+	} catch {
+		return undefined;
+	}
+}
+
+export function canonicalPlanPath(cwd: string): string | undefined {
+	const root = realCwd(cwd);
+	if (!root) return undefined;
+	return join(root, ".context", "todo.md");
+}
+
+export function expectedPlanPath(cwd: string): string {
+	return canonicalPlanPath(cwd) ?? join(resolve(cwd), ".context", "todo.md");
+}
+
+function utf8Equal(a: string, b: string): boolean {
+	return Buffer.from(a, "utf8").equals(Buffer.from(b, "utf8"));
+}
+
+function fieldFromLatin1(latin1: string): string | undefined {
+	const trimmed = trimLatin1(latin1).replace(/^[-*]\s+/, "");
+	return decodeUtf8Strict(trimmed);
+}
+
+function trimLatin1(value: string): string {
+	return value.replace(/^[ \t]+|[ \t]+$/g, "");
+}
+
+function fenceOpen(line: string): { char: string; len: number } | undefined {
+	const match = /^( {0,3})(`{3,}|~{3,})(.*)$/.exec(line);
+	if (!match) return undefined;
+	const marker = match[2];
+	const char = marker[0];
+	if (char === "`" && match[3].includes("`")) return undefined;
+	return { char, len: marker.length };
+}
+
+function fenceClose(line: string, open: { char: string; len: number }): boolean {
+	const match = /^( {0,3})(`{3,}|~{3,})[ \t]*$/.exec(line);
+	if (!match) return false;
+	const marker = match[2];
+	return marker[0] === open.char && marker.length >= open.len;
+}
+
+function splitLatin1Lines(bytes: Buffer): Array<{ text: string; start: number; end: number }> {
+	const text = bytes.toString("latin1");
+	const out: Array<{ text: string; start: number; end: number }> = [];
+	let start = 0;
+	while (start <= text.length) {
+		const nl = text.indexOf("\n", start);
+		const end = nl === -1 ? text.length : nl;
+		let line = text.slice(start, end);
+		if (line.endsWith("\r")) line = line.slice(0, -1);
+		out.push({ text: line, start, end });
+		if (nl === -1) break;
+		start = nl + 1;
+	}
+	return out;
+}
+
+export function extractGrillSection(bytes: Buffer): Buffer | undefined {
+	const rows = splitLatin1Lines(bytes);
+	let fence: { char: string; len: number } | undefined;
+	let start: number | undefined;
+	let end = bytes.length;
+	for (const row of rows) {
+		if (fence) {
+			if (fenceClose(row.text, fence)) fence = undefined;
+			continue;
+		}
+		const opened = fenceOpen(row.text);
+		if (opened) {
+			fence = opened;
+			continue;
+		}
+		if (start === undefined && HEADING.test(row.text)) {
+			start = row.start;
+			continue;
+		}
+		if (start !== undefined && /^##\s+/.test(row.text) && !HEADING.test(row.text)) {
+			end = row.start;
+			break;
+		}
+	}
+	if (start === undefined) return undefined;
+	return bytes.subarray(start, end);
+}
+
+export function hasUnfencedGrillHeading(bytes: Buffer): boolean {
+	return extractGrillSection(bytes) !== undefined;
+}
+
+export function parseGrillCheckpointFields(bytes: Buffer): { summary: string; decisions: string[]; openQuestions: string[] } | undefined {
+	const section = extractGrillSection(bytes);
+	if (!section) return undefined;
+	const lines = splitLatin1Lines(section).map((row) => row.text);
+	let summary = "";
+	const decisions: string[] = [];
+	const openQuestions: string[] = [];
+	let mode: "none" | "summary" | "decisions" | "open" = "none";
+	let decisionsInline = false;
+	for (const line of lines) {
+		if (HEADING.test(line)) continue;
+		const summaryLine = /^Summary:\s*(.*)$/.exec(line);
+		if (summaryLine) {
+			mode = "summary";
+			const decodedSummary = fieldFromLatin1(summaryLine[1]);
+			if (decodedSummary === undefined) return undefined;
+			summary = decodedSummary;
+			continue;
+		}
+		const decisionsLine = /^Decisions:\s*(.*)$/.exec(line);
+		if (decisionsLine) {
+			mode = "decisions";
+			const rest = trimLatin1(decisionsLine[1]);
+			decisionsInline = rest.length > 0;
+			if (rest) {
+				const decoded = fieldFromLatin1(rest);
+				if (decoded === undefined) return undefined;
+				decisions.push(decoded);
+			}
+			continue;
+		}
+		const openLine = /^Open questions:\s*(.*)$/.exec(line);
+		if (openLine) {
+			mode = "open";
+			const rest = trimLatin1(openLine[1]);
+			if (rest && !isOpenNone(rest)) {
+				const decoded = fieldFromLatin1(rest);
+				if (decoded === undefined) return undefined;
+				openQuestions.push(decoded);
+			}
+			continue;
+		}
+		if (!trimLatin1(line)) continue;
+		if (mode === "summary" && !decisionsInline) {
+			if (/^(Decisions|Open questions):/.test(line)) continue;
+			const decoded = fieldFromLatin1(line);
+			if (decoded === undefined) return undefined;
+			summary = summary ? `${summary}\n${decoded}` : decoded;
+		} else if (mode === "decisions" && !decisionsInline) {
+			if (!/^[-*]\s+/.test(trimLatin1(line))) continue;
+			const decoded = fieldFromLatin1(line);
+			if (decoded === undefined) return undefined;
+			decisions.push(decoded);
+		} else if (mode === "open") {
+			if (isOpenNone(line)) continue;
+			const decoded = fieldFromLatin1(line);
+			if (decoded === undefined) return undefined;
+			if (decoded) openQuestions.push(decoded);
+		}
+	}
+	if (!summary) return undefined;
+	return { summary, decisions, openQuestions };
+}
+
+function fieldsMismatch(bytes: Buffer, checkpoint: GrillCheckpoint): string | undefined {
+	const parsed = parseGrillCheckpointFields(bytes);
+	if (!parsed) return "plan_grill_section_required";
+	if (!utf8Equal(parsed.summary, checkpoint.summary)) return "plan_grill_inline_mismatch";
+	if (parsed.decisions.length !== checkpoint.decisions.length) return "plan_grill_inline_mismatch";
+	for (let i = 0; i < parsed.decisions.length; i++) {
+		if (!utf8Equal(parsed.decisions[i], checkpoint.decisions[i])) return "plan_grill_inline_mismatch";
+	}
+	if (parsed.openQuestions.length > 0) return "open_questions_remaining";
+	return undefined;
+}
+
+function fail(error: string, message: string): PlanGrillFailure {
+	return { ok: false, error, message };
+}
+
+function parentSymlinkOrMoved(filePath: string, expectedParentReal?: string): PlanGrillFailure | { ok: true; parentReal: string } {
+	const parent = dirname(filePath);
+	let st;
+	try {
+		st = planGrillIo.lstatSync(parent);
+	} catch {
+		return fail("plan_grill_symlink_escape", "Error: PLAN file must be a regular file at <cwd>/.context/todo.md; symlinks are rejected.");
+	}
+	if (st.isSymbolicLink()) {
+		return fail("plan_grill_symlink_escape", "Error: PLAN file must be a regular file at <cwd>/.context/todo.md; symlinks are rejected.");
+	}
+	let parentReal: string;
+	try {
+		parentReal = planGrillIo.realpathSync(parent);
+	} catch {
+		return fail("plan_grill_symlink_escape", "Error: PLAN file must be a regular file at <cwd>/.context/todo.md; symlinks are rejected.");
+	}
+	if (expectedParentReal && parentReal !== expectedParentReal) {
+		return fail("plan_grill_toctou", "Error: the plan path changed during read. Re-run grill_with_docs for the current file.");
+	}
+	return { ok: true, parentReal };
+}
+
+export function readCanonicalPlanBytes(cwd: string, filePath: string): PlanGrillFailure | { ok: true; absolute: string; bytes: Buffer } {
+	const expected = canonicalPlanPath(cwd);
+	if (!expected) {
+		return fail("plan_grill_plan_path_required", "Error: PLAN review must target the current .context/todo.md bound by grill_with_docs.");
+	}
+	const trimmed = filePath.trim();
+	if (!trimmed) {
+		return fail("plan_grill_plan_path_required", "Error: PLAN review must target the current .context/todo.md bound by grill_with_docs.");
+	}
+	const root = realCwd(cwd);
+	if (!root) {
+		return fail("plan_grill_plan_path_required", "Error: PLAN review must target the current .context/todo.md bound by grill_with_docs.");
+	}
+	const requested = isAbsolute(trimmed) ? resolve(trimmed) : resolve(root, trimmed);
+	if (requested !== expected) {
+		let realRequested: string | undefined;
+		try { realRequested = planGrillIo.realpathSync(requested); } catch { realRequested = undefined; }
+		if (realRequested !== expected) {
+			return fail("plan_grill_plan_path_required", "Error: PLAN review must target the current .context/todo.md bound by grill_with_docs.");
+		}
+	}
+
+	const beforeParent = parentSymlinkOrMoved(expected);
+	if (!beforeParent.ok) return beforeParent;
+
+	let before;
+	try {
+		before = planGrillIo.lstatSync(requested);
+	} catch {
+		return fail("plan_missing", "Error: write .context/todo.md with a ## Grill checkpoint section before PLAN review.");
+	}
+	if (before.isSymbolicLink()) {
+		return fail("plan_grill_symlink_escape", "Error: PLAN file must be a regular file at <cwd>/.context/todo.md; symlinks are rejected.");
+	}
+	if (!before.isFile()) {
+		return fail("plan_grill_nonregular", "Error: PLAN file must be a regular file at <cwd>/.context/todo.md.");
+	}
+
+	const flags = fsConstants.O_RDONLY | (fsConstants.O_NOFOLLOW ?? 0);
+	let fd = -1;
+	try {
+		fd = planGrillIo.openSync(requested, flags);
+		const st = planGrillIo.fstatSync(fd);
+		if (!st.isFile()) {
+			return fail("plan_grill_nonregular", "Error: PLAN file must be a regular file at <cwd>/.context/todo.md.");
+		}
+		if (st.dev !== before.dev || st.ino !== before.ino) {
+			return fail("plan_grill_toctou", "Error: the plan path changed during read. Re-run grill_with_docs for the current file.");
+		}
+		const buf = Buffer.alloc(st.size);
+		let offset = 0;
+		while (offset < st.size) {
+			const n = planGrillIo.readSync(fd, buf, offset, st.size - offset, offset);
+			if (n <= 0) break;
+			offset += n;
+		}
+		const after = planGrillIo.lstatSync(requested);
+		if (after.isSymbolicLink() || !after.isFile() || after.dev !== st.dev || after.ino !== st.ino) {
+			return fail("plan_grill_toctou", "Error: the plan path changed during read. Re-run grill_with_docs for the current file.");
+		}
+		const afterParent = parentSymlinkOrMoved(expected, beforeParent.parentReal);
+		if (!afterParent.ok) return afterParent;
+		let realFile: string;
+		try {
+			realFile = planGrillIo.realpathSync(requested);
+		} catch {
+			return fail("plan_grill_symlink_escape", "Error: PLAN file must be a regular file at <cwd>/.context/todo.md; symlinks are rejected.");
+		}
+		if (realFile !== expected) {
+			return fail("plan_grill_plan_path_required", "Error: PLAN review must target the current .context/todo.md bound by grill_with_docs.");
+		}
+		return { ok: true, absolute: expected, bytes: buf.subarray(0, offset) };
+	} catch (error: any) {
+		if (error && (error.code === "ELOOP" || error.code === "EMLINK")) {
+			return fail("plan_grill_symlink_escape", "Error: PLAN file must be a regular file at <cwd>/.context/todo.md; symlinks are rejected.");
+		}
+		return fail("plan_missing", "Error: write .context/todo.md with a ## Grill checkpoint section before PLAN review.");
+	} finally {
+		if (fd >= 0) {
+			try { planGrillIo.closeSync(fd); } catch { /* keep closed */ }
+		}
+	}
+}
+
+export function resetPlanGrill(): void {
+	stateInit();
+	const state = g();
+	state.__piPlanGrillGeneration = (state.__piPlanGrillGeneration as number) + 1;
+	state.__piPlanGrillComplete = false;
+	state.__piPlanGrillCheckpoint = null;
+	state.__piPlanReviewInFlight = null;
+}
+
+export function beginPlanReview(): PlanGrillFailure | PlanReviewBegin {
+	stateInit();
+	const state = g();
+	const generation = state.__piPlanGrillGeneration as number;
+	if (state.__piCurrentMode !== "PLAN") {
+		return { ok: true, token: null, generation };
+	}
+	const inflight = state.__piPlanReviewInFlight as InFlightReview | null;
+	if (inflight) {
+		return fail("plan_review_in_flight", "Error: a PLAN review is already in progress. Do not start the same review twice.");
+	}
+	const token = randomUUID();
+	state.__piPlanReviewInFlight = { token, generation };
+	return { ok: true, token, generation };
+}
+
+export function endPlanReview(token: string | null | undefined, approved: boolean): PlanReviewLease {
+	stateInit();
+	const state = g();
+	if (!token) return { accepted: true, stale: false };
+	const generation = state.__piPlanGrillGeneration as number;
+	const inflight = state.__piPlanReviewInFlight as InFlightReview | null;
+	if (!inflight || inflight.token !== token || inflight.generation !== generation) {
+		return { accepted: false, stale: true };
+	}
+	state.__piPlanReviewInFlight = null;
+	if (approved === true) {
+		state.__piPlanGrillComplete = false;
+		state.__piPlanGrillCheckpoint = null;
+	}
+	return { accepted: true, stale: false };
+}
+
+export function assertPlanGrillReady(opts: {
+	cwd?: string;
+	filePath?: string;
+	content?: string;
+	bytes?: Buffer;
+}): PlanGrillFailure | PlanGrillReady {
+	stateInit();
+	const state = g();
+	if (state.__piCurrentMode !== "PLAN") {
+		const cwd = opts.cwd || process.cwd();
+		const bytes = opts.bytes ?? (opts.content !== undefined ? Buffer.from(opts.content, "utf8") : Buffer.alloc(0));
+		return {
+			ok: true,
+			absolute: opts.filePath ? resolve(cwd, opts.filePath) : join(cwd, ".context", "todo.md"),
+			planHash: hashPlanBytes(bytes),
+			bytes,
+		};
+	}
+
+	const cwd = opts.cwd || process.cwd();
+	const filePath = opts.filePath?.trim() || "";
+	const loaded = filePath
+		? readCanonicalPlanBytes(cwd, filePath)
+		: fail("plan_grill_plan_path_required", "Error: PLAN review must target the current .context/todo.md bound by grill_with_docs.");
+	if (!loaded.ok) return loaded;
+
+	const diskBytes = loaded.bytes;
+	if (opts.bytes && !opts.bytes.equals(diskBytes)) {
+		return fail("plan_grill_hash_mismatch", "Error: the plan changed after the grill checkpoint. Re-run grill_with_docs for the current file.");
+	}
+	if (opts.content !== undefined && !Buffer.from(opts.content, "utf8").equals(diskBytes)) {
+		return fail("plan_grill_hash_mismatch", "Error: the plan changed after the grill checkpoint. Re-run grill_with_docs for the current file.");
+	}
+
+	const checkpoint = state.__piPlanGrillCheckpoint as GrillCheckpoint | null;
+	if (state.__piPlanGrillComplete !== true || !checkpoint) {
+		return fail("plan_grill_required", "Error: complete and bind the grill-with-docs checkpoint with grill_with_docs before opening the PLAN review.");
+	}
+	if (checkpoint.planFilePath !== loaded.absolute) {
+		return fail("plan_grill_plan_path_required", "Error: PLAN review must target the current .context/todo.md bound by grill_with_docs.");
+	}
+	if (!readSkill(checkpoint.skillPath || skillPath())) {
+		return fail("skill_missing", `Error: grill-with-docs skill not found or invalid at ${checkpoint.skillPath || skillPath()}. Restore the skill before planning.`);
+	}
+	if (!hasUnfencedGrillHeading(diskBytes)) {
+		return fail("plan_grill_section_required", `Error: ${filePath} must include the ## Grill checkpoint section before PLAN review.`);
+	}
+	const planHash = hashPlanBytes(diskBytes);
+	if (checkpoint.planHash !== planHash) {
+		return fail("plan_grill_hash_mismatch", "Error: the plan changed after the grill checkpoint. Re-run grill_with_docs for the current file.");
+	}
+	const mismatch = fieldsMismatch(diskBytes, checkpoint);
+	if (mismatch) {
+		return fail(mismatch, "Error: grill checkpoint summary/decisions must match the current plan file.");
+	}
+	if (!Array.isArray(checkpoint.openQuestions) || checkpoint.openQuestions.length > 0) {
+		return fail("open_questions_remaining", "Error: grill checkpoint requires a non-empty summary and zero open questions.");
+	}
+	return { ok: true, absolute: loaded.absolute, planHash, bytes: diskBytes };
+}
+
+function toolFilePath(params: unknown): string | undefined {
+	if (!params || typeof params !== "object") return undefined;
+	const record = params as Record<string, unknown>;
+	const value = record.file_path ?? record.filePath ?? record.plan_file_path;
+	return typeof value === "string" ? value : undefined;
+}
+
+function claimedApproved(details: unknown, isError: unknown): boolean {
+	if (isError === true) return false;
+	if (!details || typeof details !== "object") return false;
+	const record = details as Record<string, unknown>;
+	return record.approved === true || record.action === "approved";
+}
+
+function unverifiedPatch(event: any) {
+	return {
+		content: event?.content,
+		details: {
+			...((event?.details && typeof event.details === "object") ? event.details : {}),
+			approved: false,
+			action: "declined",
+			error: "plan_grill_unverified_result",
+		},
+		isError: event?.isError === true,
+	};
+}
+
+export default function (pi: ExtensionAPI): void {
+	const state = g();
+	state.__piResetPlanGrill = resetPlanGrill;
+	state.__piAssertPlanGrillReady = assertPlanGrillReady;
+	state.__piBeginPlanReview = beginPlanReview;
+	state.__piEndPlanReview = endPlanReview;
+	resetPlanGrill();
+
+	pi.registerTool({
+		name: "grill_with_docs",
+		label: "Grill With Docs",
+		description:
+			"Bind the completed grill-with-docs checkpoint to the current PLAN file. " +
+			"Run the skill's question rounds first and write .context/todo.md; this tool verifies the current bytes.",
+		parameters: Type.Object({
+			plan_file_path: Type.String({ description: "Current plan path; must resolve to .context/todo.md." }),
+			summary: Type.String({ description: "Non-empty summary of the shared understanding." }),
+			decisions: Type.Optional(Type.Array(Type.String(), { description: "Confirmed terminology and decisions." })),
+			open_questions: Type.Array(Type.String(), { description: "Questions that remain unresolved; must be empty to complete." }),
+		}),
+
+		async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
+			if (state.__piCurrentMode !== "PLAN") {
+				return {
+					content: [{ type: "text", text: "Error: grill_with_docs is only a PLAN-mode checkpoint." }],
+					details: { complete: false, error: "plan_mode_required" },
+				};
+			}
+
+			const { plan_file_path: planFilePath, summary, decisions = [], open_questions: openQuestions } = params as {
+				plan_file_path: string;
+				summary: string;
+				decisions?: string[];
+				open_questions: string[];
+			};
+			const cwd = ctx?.cwd || process.cwd();
+			const loaded = readCanonicalPlanBytes(cwd, planFilePath);
+			if (!loaded.ok) {
+				return {
+					content: [{ type: "text", text: loaded.message }],
+					details: { complete: false, error: loaded.error },
+				};
+			}
+
+			const trimmedSummary = summary.trim();
+			const skill = skillPath();
+			if (!readSkill(skill)) {
+				return {
+					content: [{ type: "text", text: `Error: grill-with-docs skill not found or invalid at ${skill}. Restore the skill before planning.` }],
+					details: { complete: false, error: "skill_missing", skillPath: skill },
+				};
+			}
+			if (!trimmedSummary || openQuestions.length > 0) {
+				return {
+					content: [{ type: "text", text: "Error: grill checkpoint requires a non-empty summary and zero open questions." }],
+					details: { complete: false, error: "open_questions_remaining" },
+				};
+			}
+			if (!hasUnfencedGrillHeading(loaded.bytes)) {
+				return {
+					content: [{ type: "text", text: "Error: .context/todo.md must include the ## Grill checkpoint section." }],
+					details: { complete: false, error: "plan_grill_section_required" },
+				};
+			}
+
+			const checkpoint: GrillCheckpoint = {
+				planFilePath: loaded.absolute,
+				planHash: hashPlanBytes(loaded.bytes),
+				summary: trimmedSummary,
+				decisions,
+				openQuestions,
+				skillPath: skill,
+			};
+			const mismatch = fieldsMismatch(loaded.bytes, checkpoint);
+			if (mismatch) {
+				return {
+					content: [{ type: "text", text: "Error: grill checkpoint summary/decisions must match the current plan file." }],
+					details: { complete: false, error: mismatch },
+				};
+			}
+
+			state.__piPlanGrillComplete = true;
+			state.__piPlanGrillCheckpoint = checkpoint;
+			return {
+				content: [{
+					type: "text",
+					text: `Grill checkpoint complete and bound to ${planFilePath}. Call show_plan for this same file to get approval; do not edit it before review.`,
+				}],
+				details: { complete: true, checkpoint },
+			};
+		},
+	});
+
+	pi.on("tool_call", async (event, ctx) => {
+		const toolName = event?.toolName || event?.name;
+		if (state.__piCurrentMode !== "PLAN") return;
+		if (BLOCKED_PLAN_EXTERNAL_TOOLS.has(toolName)) {
+			return {
+				block: true,
+				reason: "Error: in PLAN mode use show_plan for approval. Direct plannotator_submit_plan / plannotator_review calls are blocked.",
+			};
+		}
+		if (!GATED_INTERNAL_PLAN_TOOLS.has(toolName)) return;
+		const cwd = ctx?.cwd || process.cwd();
+		const params = event.input || event.arguments || event.params || {};
+		const ready = assertPlanGrillReady({ cwd, filePath: toolFilePath(params) });
+		if (!ready.ok) return { block: true, reason: ready.message };
+		const inflight = state.__piPlanReviewInFlight as InFlightReview | null;
+		if (inflight) {
+			return { block: true, reason: "Error: a PLAN review is already in progress. Do not start the same review twice." };
+		}
+	});
+
+	pi.on("tool_result", async (event) => {
+		const toolName = event?.toolName || event?.name;
+		if (state.__piCurrentMode !== "PLAN") return;
+		if (!GATED_INTERNAL_PLAN_TOOLS.has(toolName) && !BLOCKED_PLAN_EXTERNAL_TOOLS.has(toolName)) return;
+		if (!claimedApproved(event?.details, event?.isError)) return;
+		if (state.__piPlanGrillComplete === true) return unverifiedPatch(event);
+	});
+
+	pi.on("session_start", async () => resetPlanGrill());
+	pi.on("session_switch", async () => resetPlanGrill());
+	pi.on("session_shutdown", async () => resetPlanGrill());
+}
