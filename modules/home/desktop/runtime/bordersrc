#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.nix-profile/bin:/etc/profiles/per-user/$(id -un)/bin:/run/current-system/sw/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
PYTHON="${YABAI_CONFIG_PYTHON:-@python@}"
COLORS_SCRIPT="$HOME/.config/sketchybar/colors.py"
active1=0xffe0e0e0
active2=0xffb0b0b0
inactive=0x40000000
if [ -f "$COLORS_SCRIPT" ]; then
    read -r active1 active2 inactive < <("$PYTHON" "$COLORS_SCRIPT" --borders)
fi
exec borders style=round width=3.0 hidpi=on \
    "active_color=gradient(top_left=$active1,bottom_right=$active2)" \
    "inactive_color=$inactive"
