# Single-purpose Machine only. Does not flush other tables.
table inet devbox {
  chain input {
    type filter hook input priority -10; policy drop;
    iifname "lo" accept
    ct state established,related accept
    iifname "tailscale0" tcp dport 6768 accept
    # Tailscale encrypted transport; no application ports on eth0/6PN.
    udp dport 41641 accept
    meta l4proto { icmp, ipv6-icmp } accept
  }
  chain forward {
    type filter hook forward priority -10; policy drop;
  }
}
